---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'Playground', template: 'splash' }}>
    <html lang="zh">
        <head>
            <meta charset="UTF-8" />
            <title>Playground</title>
            <style>
                body, html { margin: 0; padding: 0; height: 100vh; overflow: auto; }
                iframe { width: 100%; height: 100%; min-height: 75vh; border: none; display: block; }
            </style>
        </head>
        <body>
            <iframe src={`${import.meta.env.BASE_URL}/playground.html`} title="Playground"></iframe>
        </body>
    </html>
</StarlightPage>
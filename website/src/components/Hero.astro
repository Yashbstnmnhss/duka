---
import { LinkButton } from '@astrojs/starlight/components'
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice'
import mascotSource from '../assets/moelogo.svg?raw'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero || {}
---

<div class="hero">
    <div class="mascot-stage" data-mascot role="img" aria-label="Duka Logo">
        <span class="orbit orbit-one" aria-hidden="true"></span>
        <span class="orbit orbit-two" aria-hidden="true"></span>
        <span class="spark spark-one" aria-hidden="true"></span>
        <span class="spark spark-two" aria-hidden="true"></span>
        <div class="mascot-depth">
            <div class="mascot-art" set:html={mascotSource} />
        </div>
    </div>
    <div class="sl-flex stack">
        <div class="sl-flex copy">
            <h1 id="_top" data-page-title set:html={title} />
            {data.draft && <DraftContentNotice />}
            {tagline && <div class="tagline" set:html={tagline} />}
        </div>
        {
            actions.length > 0 && (
                <div class="sl-flex actions">
                    {actions.map(
                        ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
                            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                                {text}
                                {icon?.html && <Fragment set:html={icon.html} />}
                            </LinkButton>
                        )
                    )}
                </div>
            )
        }
    </div>
</div>

<script>
    const stage = document.querySelector<HTMLElement>('[data-mascot]')
    const svg = stage?.querySelector('svg')

    if (stage && svg) {
        svg.querySelectorAll('#right-ear, #left-ear').forEach((ear) => {
            if (!(ear instanceof SVGGElement) || ear.parentElement?.classList.contains('ear-pivot')) return

            const pivot = document.createElementNS('http://www.w3.org/2000/svg', 'g')
            pivot.setAttribute('class', ear.id === 'left-ear' ? 'ear-pivot ear-pivot--late' : 'ear-pivot')
            ear.parentElement?.insertBefore(pivot, ear)
            pivot.appendChild(ear)
        })

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
        const updateGaze = (event: PointerEvent) => {
            if (reducedMotion.matches) return

            const bounds = stage.getBoundingClientRect()
            const x = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width - 0.5) * 2))
            const y = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height - 0.5) * 2))

            stage.style.setProperty('--tilt-x', `${x * 10}deg`)
            stage.style.setProperty('--tilt-y', `${y * 9}deg`)
            stage.style.setProperty('--look-x', `${x * 12}px`)
            stage.style.setProperty('--look-y', `${y * 13}px`)
        }

        const resetGaze = () => {
            stage.style.setProperty('--tilt-x', '0deg')
            stage.style.setProperty('--tilt-y', '0deg')
            stage.style.setProperty('--look-x', '0px')
            stage.style.setProperty('--look-y', '0px')
        }

        stage.addEventListener('pointermove', updateGaze)
        stage.addEventListener('pointerleave', resetGaze)
        reducedMotion.addEventListener('change', () => {
            if (reducedMotion.matches) resetGaze()
        })
    }
</script>

<style>
    .hero {
        display: grid;
        grid-template-columns: 100%;
        align-items: center;
        gap: 1rem;
        padding-bottom: 1rem;
    }

    .mascot-stage {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        --look-x: 0px;
        --look-y: 0px;
        position: relative;
        isolation: isolate;
        display: grid;
        place-items: center;
        width: min(76%, 23rem);
        aspect-ratio: 1;
        margin-inline: auto;
        perspective: 900px;
        transform-style: preserve-3d;
        touch-action: pan-y;
    }

    .mascot-stage::before {
        position: absolute;
        z-index: -1;
        inset: 13%;
        border: 1px solid color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
        border-radius: 50%;
        content: '';
        transform: translateZ(-30px);
    }

    .mascot-stage::after {
        position: absolute;
        z-index: -2;
        inset: 23%;
        border: 1px dashed color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
        border-radius: 50%;
        content: '';
        transform: translateZ(-55px);
    }

    .mascot-depth {
        width: 100%;
        transform: rotateX(calc(var(--tilt-y) * -1)) rotateY(var(--tilt-x));
        transform-style: preserve-3d;
        transition: transform 180ms ease-out;
        will-change: transform;
    }

    .mascot-art {
        animation: mascot-float 5s ease-in-out infinite;
        filter: drop-shadow(0 1.25rem 1.5rem color-mix(in srgb, var(--sl-color-black) 28%, transparent));
        transform-style: preserve-3d;
    }

    .mascot-art :global(svg) {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .mascot-art :global(#righteye),
    .mascot-art :global(#lefteye) {
        transform-box: fill-box;
        transform-origin: center;
        translate: calc(var(--look-x) * 0.35) calc(var(--look-y) * 0.35);
        animation: mascot-blink 7s ease-in-out infinite;
        transition: translate 160ms ease-out;
    }

    .mascot-art :global(.ear-pivot) {
        transform-box: fill-box;
        transform-origin: center bottom;
        animation: mascot-ear 4.8s ease-in-out infinite;
    }

    .mascot-art :global(.ear-pivot--late) {
        animation-delay: -2.4s;
    }

    .mascot-art :global(#mouth) {
        transform-box: fill-box;
        transform-origin: center;
        animation: mascot-mouth 3.6s ease-in-out infinite;
    }

    .orbit,
    .spark {
        position: absolute;
        pointer-events: none;
    }

    .orbit {
        width: 7px;
        height: 7px;
        border: 1px solid var(--sl-color-accent);
        border-radius: 50%;
        opacity: 0.72;
        transform: translateZ(35px);
    }

    .orbit-one {
        top: 22%;
        right: 17%;
    }

    .orbit-two {
        bottom: 25%;
        left: 14%;
        width: 5px;
        height: 5px;
        opacity: 0.45;
        transform: translateZ(65px);
    }

    .spark {
        width: 9px;
        height: 1px;
        background: var(--sl-color-accent);
        opacity: 0.7;
        transform: translateZ(45px) rotate(-45deg);
    }

    .spark-one {
        top: 30%;
        left: 15%;
    }

    .spark-two {
        right: 13%;
        bottom: 35%;
        transform: translateZ(25px) rotate(45deg);
    }

    .stack {
        flex-direction: column;
        gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
        text-align: center;
    }

    .copy {
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .copy > * {
        max-width: 50ch;
    }

    h1 {
        color: var(--sl-color-white);
        font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
        font-weight: 600;
        line-height: var(--sl-line-height-headings);
    }

    .tagline {
        color: var(--sl-color-gray-2);
        font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    }

    .actions {
        flex-wrap: wrap;
        gap: 1rem 2rem;
        justify-content: center;
    }

    @keyframes mascot-float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-7px);
        }
    }

    @keyframes mascot-blink {
        0%,
        92%,
        96%,
        100% {
            scale: 1 1;
        }
        94% {
            scale: 1 0.08;
        }
    }

    @keyframes mascot-ear {
        0%,
        84%,
        100% {
            rotate: 0deg;
        }
        88% {
            rotate: -5deg;
        }
        92% {
            rotate: 2deg;
        }
    }

    @keyframes mascot-mouth {
        0%,
        100% {
            scale: 1 1;
        }
        50% {
            scale: 1 0.9;
        }
    }

    @media (min-width: 50rem) {
        .hero {
            grid-template-columns: 7fr 4fr;
            gap: 3%;
            padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
        }

        .mascot-stage {
            order: 2;
            width: min(100%, 25rem);
        }

        .stack {
            text-align: start;
        }

        .copy {
            align-items: flex-start;
        }

        .actions {
            justify-content: flex-start;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mascot-depth {
            transition: none;
        }

        .mascot-art,
        .mascot-art :global(#righteye),
        .mascot-art :global(#lefteye),
        .mascot-art :global(.ear-pivot),
        .mascot-art :global(#mouth) {
            animation: none;
        }
    }
</style>

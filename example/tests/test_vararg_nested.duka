local function make_el(n)
    return n
end

local function h(tag, props, ...)
    local a = [...]
    local total = 0
    for i = 0, #a - 1 do
        total = total + a[i]
    end
    return total
end

local t = {}
t.h = h

local a = make_el(1)
local b = make_el(2)
local result = t.h("div", {}, a, b, make_el(3))
assert(result == 6, "result should be 6, got " .. to_string(result))

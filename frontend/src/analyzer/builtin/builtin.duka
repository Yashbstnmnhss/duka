export type function Optional(t) = t?

--- Every value in a pack, with numbers widened: one `float` makes it one.
export type function Widen(T)
    local out = never
    if #T == 0 then
        return any
    end
    for t in T do
        if SameAs(t, float) then
            return float
        end
        out = out | t
    end
    return out
end

--- What a pack of numeric values answers. A single array or table answers
--- its element instead, and may be empty.
export type function NumRet(T)
    if #T == 1 then
        local one = T[0]
        if IsSubType(one, array) then
            return Optional(Elem(one))
        end
        if IsSubType(one, table) then
            return Optional(Elem(one))
        end
    end
    return Widen(T)
end

--- A return list of zero or more `T`.
export type function Repeat(T) = [...T]

--- The two values a fallible call answers with: ok and its value, or the
--- error and what went wrong.
export type function Result2(T) = [true, T] | [false, string]

--- The record `os.date` answers with.
export type DateTime = {
    year: int,
    month: int,
    day: int,
    hour: int,
    minute: int,
    second: int
}

export type function Omit(target: table, keys)
    local obj = {}
    for key, val in target do
        if In(key, keys) then continue end
        obj[key] = val
    end
    return obj
end

export type function Pick(target: table, keys)
    local obj = {}
    for key in Unpack(keys) do
        if In(key, target) then
            obj[key] = target[key]
        end
    end
    return obj
end

export type function Partial(obj: table)
    local res = {}
    for key, val in obj do
        res[key] = val?
    end
    return res
end

export type function Required(obj: table)
    local res = {}
    for key, val in obj do
        res[key] = val!
    end
    return res
end

export type function Record(key, val)
    if IsIterable(key) then
        local res = {}

        if IsIterable(val) then
            for k in key do
                for v in val do
                    res[k] = v
                end
            end
            return res
        end

        for k in key do
            res[k] = val
        end
        return res
    else
        return table<key, val>
    end
end

export type function BuildObject(keys, types)
    Assert(#keys == #types, "Lengths of keys and types must be equal")
    local obj = {}
    local ls = IsIterable(types)
    for i = 0, #keys do
        if ls then
            obj[keys[i]] = types[i]
        else
            obj[keys[i]] = types
        end
    end
    return obj
end

export type function TypeList(T) = [T, TypeList(T)?]
export type function TypeTree(T) = [T, TypeTree(T)?, TypeTree(T)?]

export type CoStatus =
    [:COSTATUS0:] |
    [:COSTATUS1:] |
    [:COSTATUS2:] |
    [:COSTATUS3:] |
    [:COSTATUS4:]

export type FileType = 
    [:FILE_TYPE0:] |
    [:FILE_TYPE1:]

export type function Iterator(var_ret: bool, a, b) = BuildFunction(never, false, [bool, a, b], var_ret)

export type function Yield(var_ret: bool, a) = BuildFunction(never, false, [bool, a], var_ret)
export type function Result(...Ts) = [true, ...Ts] | [false, string] 

--- for `unpack`
export type function UnpackRet(arr: array)
    if IsTuple(arr) then
        return arr
    else
        return [...Elem(arr)]
    end
end

--- `select` answers with what its pattern picks: the count for `"#"`, the value
--- at a literal index, and the tail's members for an array of indices.
export type function Select(pat, vals)
    if SameAs(pat, "#") then
        return int
    end
    if IsIterable(vals) then
        -- an array pattern is a tuple of indices: one slot per index, in order
        if IsIterable(pat) then
            local out = []
            for i in pat do
                if i >= #vals and IsLoosely(vals) then
                    out = Append(out, Optional(Elem(vals)))
                    continue
                end
                out = Append(out, vals[i])
            end
            return out
        end
        -- a computed index or array: one value of the tail's type, and more may
        -- follow -- the return is a `...` position
        if SameAs(pat, Super(pat)) then
            return Union(vals)
        end
        -- a literal index; the accessor counts a negative one from the tail
        if pat < #vals then
            return vals[pat]
        end
        -- past the prefix the tail says what a value is, and the sequence may
        -- have stopped before this place, so it may also be nothing
        if IsLoosely(vals) then
            return Optional(Elem(vals))
        end
        return nil
    end
    return any
end

-- Concepts:
export type function SameAs(T, U) 
    return T == U
end

export type function Integral(T)
    return match T then
        float or int -> true;
    else 
        return false
    end
end

export type function IsSubOf(A, B) = IsSubType(A, B)

export type Unsigned = GePat(int, 0)

type UnitMT = { __mul = MulUnit, __div = DivUnit, __pow = PowUnit }

export type function Unit(text)
    return WithMetatable(ParseUnit(text), UnitMT)
end

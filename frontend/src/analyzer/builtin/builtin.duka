--@builtin
--@title Duka type-context built-in functions

export type function Optional(t)
    return t?
end

export type function NonNil(t)
    return t!
end

export type function Omit(target: table, keys)
    local obj = {}
    for key, val in target do
        if In(key, keys) then continue end
        obj[key] = val
    end
    return obj
end

export type function Pick(target: table, keys)
    local obj = {}
    for key in Unpack(keys) do
        obj[key] = target[key]
    end
    return obj
end

export type function Record(key, val)
    -- TODO
end

export type function BuildObject(keys, types)
    local _ = Assert(#keys == #types, "Lengths of keys and types must be equal")
    local obj = {}
    for i = 0, #keys do
        obj[keys[i]] = types[i]
    end
    return obj
end

export type function List(T) = [T, List(T)?]
export type function Tree(T) = [T, Tree(T)?, Tree(T)?]
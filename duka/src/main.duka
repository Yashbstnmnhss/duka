local ui = require("duka-ui")
local hero = require("./components/Hero")
local code_block = require("./components/CodeBlock")
local feature_card = require("./components/FeatureCard")
local watermark = require("./components/Watermark")
local footer = require("./components/Footer")

local svg_docs_viewbox = "0 0 16 16"
local svg_docs_path = "M5 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V5.414a1.5 1.5 0 0 0-.44-1.06L9.647 1.439A1.5 1.5 0 0 0 8.586 1H5zM4 3a1 1 0 0 1 1-1h3v2.5A1.5 1.5 0 0 0 9.5 6H12v7a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V3zm7.793 2H9.5a.5.5 0 0 1-.5-.5V2.207L11.793 5z"

local svg_quick_viewbox = "0 0 24 24"
local svg_quick_path = "M4.25 4A2.25 2.25 0 0 0 2 6.25v2.5A2.25 2.25 0 0 0 4.25 11h2.5A2.25 2.25 0 0 0 9 8.75v-2.5A2.25 2.25 0 0 0 6.75 4h-2.5zM3.5 6.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75v-2.5zM11.25 5a.75.75 0 0 0 0 1.5h10a.75.75 0 0 0 0-1.5h-10zm0 3a.75.75 0 0 0 0 1.5h7a.75.75 0 0 0 0-1.5h-7zm-7 5A2.25 2.25 0 0 0 2 15.25v2.5A2.25 2.25 0 0 0 4.25 20h2.5A2.25 2.25 0 0 0 9 17.75v-2.5A2.25 2.25 0 0 0 6.75 13h-2.5zm-.75 2.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75v-2.5zM11.25 14a.75.75 0 0 0 0 1.5h10a.75.75 0 0 0 0-1.5h-10zm0 3a.75.75 0 0 0 0 1.5h7a.75.75 0 0 0 0-1.5h-7z"

local svg_github_viewbox = "0 0 24 24"
local svg_github_path = "M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2c2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2a4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6c-.6.6-.6 1.2-.5 2V21"

local code_example = [=[
export type function Pick(target: table, keys)
    local obj = {}
    for key in Unpack(keys) do
        if In(key, target) then
            obj[key] = target[key]
        end
    end
    return obj
end]=]

local hero_vnode = hero.Hero()
local code_vnode = code_block.CodeBlock(code_example)
local footer_vnode = footer.Footer()

local card1 = feature_card.FeatureCard("Documents", "Documents for Duka", "#", "Read ->", svg_docs_viewbox, svg_docs_path, false)
local card2 = feature_card.FeatureCard("Quick Start", "Examples & Guidelines", "#", "Go ->", svg_quick_viewbox, svg_quick_path, false)
local card3 = feature_card.FeatureCard("Github", "Sources", "#", "See ->", svg_github_viewbox, svg_github_path, true)

local grid = ui! {
    div(class = "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8") {
        card1
        card2
        card3
    }
}
local features = ui! { 
    div(class = "max-w-7xl mx-auto px-6 py-12") { 
        grid 
    } 
}
local app = ui! {
    div(class = "flex flex-col min-h-screen") {
        hero_vnode
        code_vnode
        features
        footer_vnode
    }
}

watermark.Watermark()
ui.mount("#app", app)

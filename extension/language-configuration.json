{
    "comments": {
        "lineComment": {
            "comment": "--",
            "noIndent": false
        },
        "blockComment": ["--[[", "]]"]
    },
    "brackets": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["[[", "]]"],
        ["{", "}"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[[", "]]"],
        ["<", ">"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "autoCloseBefore": ";:.,=}])> \n\t",
    "folding": {
        "markers": {
            "start": "^\\s*--\\s*#?region\\b",
            "end": "^\\s*--\\s*#?endregion\\b"
        }
    },
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(?:(type function)|function|object|do|then|else|elseif)\\b(?!.*\\b(end|=)\\b\\s*$)",
        "decreaseIndentPattern": "^\\s*(?:end|elseif|else)\\b.*$"
    },
    "colorizedBracketPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ]
}
